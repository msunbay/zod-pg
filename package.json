{
  "name": "zod-pg",
  "version": "5.2.1",
  "description": "Opinionated Zod schema generator for PostgreSQL databases",
  "packageManager": "npm@10.8.2",
  "main": "./dist/index.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "bin": {
    "zod-pg": "index.js"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "build": "rm -rf ./dist && tsc --project tsconfig.build.json",
    "start": "npm run build && node index.js",
    "dev": "tsx dev.ts",
    "test": "npm run build && npm run test:integration && npm run test:types",
    "test:integration": "npm run test:integration:cli && npm run test:integration:schema",
    "test:integration:cli": "vitest --project integration:cli run",
    "test:integration:schema": "vitest --project integration:schema run",
    "test:types": "tsc --noEmit",
    "test:watch": "jest --watch",
    "format": "prettier --write ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/msunbay/zod-pg.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "zod",
    "zod-dbs",
    "typescript",
    "validation",
    "pg",
    "postgres",
    "postgresql",
    "database",
    "sql",
    "schema",
    "generator",
    "types",
    "codegen",
    "schema-generator",
    "type-safe",
    "validation-schema"
  ],
  "files": [
    "dist",
    "templates"
  ],
  "author": "msolvaag",
  "license": "ISC",
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "zod": "^4.5.4"
  },
  "peerDependencies": {
    "pg": ">=8.12.0"
  },
  "dependencies": {
    "zod-dbs-cli": "^2.2.1",
    "zod-dbs-pg": "^2.0.6"
  }
}
